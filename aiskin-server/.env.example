# Ports
API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8081
PRODUCT_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
AI_SCAN_PORT=5000
RECOMMENDATION_PORT=5001

# Databases - use separate database names even when sharing one Atlas cluster
MONGODB_URI_USER=mongodb://localhost:27017/aiskin_user
MONGODB_URI_PRODUCT=mongodb://localhost:27017/aiskin_product
MONGODB_URI_ORDER=mongodb://localhost:27017/aiskin_order
MONGODB_URI_SCAN=mongodb://localhost:27017/ai_scan_db
MONGODB_URI_RECOMMENDATION=mongodb://localhost:27017/ai_scan_db

# Messaging and inter-service URLs
RECOMMENDATION_SERVICE_URL=http://localhost:5001
PRODUCT_SERVICE_BASE_URL=http://localhost:8082
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379

# Generate a Base64-encoded secret that decodes to at least 32 random bytes
JWT_SECRET=REPLACE_WITH_BASE64_SECRET
JWT_ISSUER=aiskin-user-service
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_TOKEN

# Auth development settings
OTP_TTL=300
OTP_EXPOSE=true
GOOGLE_CLIENT_ID=

# OTP email. Local: keep MAIL_ENABLED=false and OTP_EXPOSE=true.
# Production: set MAIL_ENABLED=true, OTP_EXPOSE=false and configure SMTP.
MAIL_ENABLED=false
MAIL_FROM=no-reply@aiskin.local
MAIL_SUBJECT_PREFIX=[AiSkin]
MAIL_LOG_OTP=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false

# AI scan
AI_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
SCAN_IMAGE_SIGNING_SECRET=REPLACE_WITH_RANDOM_SIGNING_SECRET
AI_SCAN_UPLOAD_DIR=
SCAN_RATE_LIMIT_PER_MINUTE=10
VALIDATE_RATE_LIMIT_PER_MINUTE=30
SCAN_RETENTION_DAYS=90
AI_MAX_CONCURRENT_INFERENCE=2
AI_INFERENCE_QUEUE_TIMEOUT_SECONDS=5

# Recommendation and chatbot
RECOMMENDATION_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=

# Payment sandbox
HTTP_CONNECT_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_NOTIFY_URL=http://localhost:8080/api/orders/payment/momo-ipn
MOMO_RETURN_URL=http://localhost:5174/payment/momo-return
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:5174/payment/vnpay-return
VNPAY_BANK_CODE=NCB

# Shipping sandbox
GHN_API_URL=
GHN_TOKEN=
GHN_SHOP_ID=

# Return evidence uploads
UPLOAD_DIR=uploads
