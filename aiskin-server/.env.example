# Ports
API_GATEWAY_PORT=8080
DISCOVERY_SERVER_PORT=8761
USER_SERVICE_PORT=8081
PRODUCT_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
AI_SCAN_PORT=5000
RECOMMENDATION_PORT=5001

# Databases - use separate database names even when sharing one Atlas cluster
MONGODB_URI_USER=mongodb://localhost:27017/aiskin_user
MONGODB_URI_PRODUCT=mongodb://localhost:27017/aiskin_product
MONGODB_URI_ORDER=mongodb://localhost:27017/aiskin_order
MONGODB_URI_SCAN=mongodb://localhost:27017/ai_scan_db
MONGODB_URI_RECOMMENDATION=mongodb://localhost:27017/ai_scan_db

# Service discovery and messaging
EUREKA_URI=http://localhost:8761/eureka
RECOMMENDATION_SERVICE_URL=http://localhost:5001
PRODUCT_SERVICE_BASE_URL=http://localhost:8082
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDIS_HOST=localhost
REDIS_PORT=6379

# Generate a Base64-encoded secret that decodes to at least 32 random bytes
JWT_SECRET=REPLACE_WITH_BASE64_SECRET
JWT_ISSUER=aiskin-user-service
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_TOKEN

# Auth development settings
OTP_TTL=300
OTP_EXPOSE=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI scan
AI_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
SCAN_IMAGE_SIGNING_SECRET=REPLACE_WITH_RANDOM_SIGNING_SECRET
SCAN_RATE_LIMIT_PER_MINUTE=10
VALIDATE_RATE_LIMIT_PER_MINUTE=30
SCAN_RETENTION_DAYS=90

# Recommendation and chatbot
RECOMMENDATION_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Payment sandbox
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_NOTIFY_URL=http://localhost:8080/api/orders/payment/momo-ipn
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=
VNPAY_API_URL=
VNPAY_RETURN_URL=http://localhost:5174/orders

# Shipping sandbox
GHN_API_URL=
GHN_TOKEN=
GHN_SHOP_ID=

# Return evidence uploads
UPLOAD_DIR=uploads
