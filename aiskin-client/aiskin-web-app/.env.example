# Google OAuth Client ID for sign-in
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend API Base URL (empty uses dev proxy)
VITE_API_BASE_URL=

# Optional: bypass the API Gateway when debugging one Python service directly.
# Leave empty for normal development and production routing through VITE_API_BASE_URL.
VITE_AI_SCAN_BASE_URL=
VITE_RECOMMENDATION_BASE_URL=
